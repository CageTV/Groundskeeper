<Window x:Class="LandscapeHybrid.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Groundskeeper" Icon="Assets/Groundskeeper.ico" Height="720" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3,4,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: logo with a slow glow, the name, and the strip of passes that lights up while a run goes -->
        <Border Grid.Row="0" CornerRadius="10" Margin="0,0,0,10" Padding="16,10" BorderThickness="1" BorderBrush="#FF3A3F4C">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF262B39" Offset="0"/>
                    <GradientStop Color="#FF1C1F28" Offset="0.55"/>
                    <GradientStop Color="#FF33231A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Source="Assets/logo.png" Height="52" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect x:Name="LogoGlow" Color="#FFFF8A3D" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                    </Image.Effect>
                </Image>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Groundskeeper" FontSize="28" FontWeight="Bold" Margin="0">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFC45E" Offset="0"/>
                                <GradientStop Color="#FFE0782E" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Tend the land. Mend the seams." Style="{StaticResource Hint}" Margin="2,0,0,0"/>
                </StackPanel>
                <WrapPanel x:Name="StageStrip" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FF3A2F05" BorderBrush="#FF8A6F00" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Foreground="#FFFFD966" TextWrapping="Wrap" Margin="0" FontSize="12">
                Not yet tested in-game. Runs the landscape tools (seams, texture layers, roads, floating objects) over your
                Mod Organizer 2 load order and merges them into one plugin. Works alongside Landscape Fixer by Cl3mus33:
                its LandscapeFixer.esp is never used as a source, so run the two in either order.
            </TextBlock>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="440"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="12*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <GroupBox Header="MOD MANAGER">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="ModeMo2" Content="Mod Organizer 2" GroupName="Mode" IsChecked="True" Checked="Mode_Checked" Margin="0,0,20,4"/>
                                <RadioButton x:Name="ModeDirect" Content="Vortex or plain install (game Data folder)" GroupName="Mode" Checked="Mode_Checked" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="InstanceLabel" Grid.Row="0" Text="Instance folder:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="InstanceBox" TextChanged="InstanceBox_TextChanged"/>
                                <Button x:Name="InstanceBrowse" Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseInstance_Click"/>
                                <TextBlock x:Name="ProfileLabel" Grid.Row="1" Text="Profile:"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ProfileCombo" Margin="0,3,4,3"/>
                                <TextBlock x:Name="ProfileHint" Grid.Row="1" Grid.Column="2" Text="(auto-listed)" Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="GameLabel" Grid.Row="2" Text="Game folder (optional):" ToolTip="MO2: left empty, read from ModOrganizer.ini. Vortex / plain: left empty, found from the registry."/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="GameBox"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseGame_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="OUTPUT">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output folder:"/>
                                <TextBox Grid.Column="1" x:Name="OutputBox"/>
                                <Button Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Plugin name:"/>
                                <TextBox Grid.Column="1" x:Name="PluginNameBox" Text="Groundskeeper.esp"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap">
                                In Mod Organizer 2, leave this empty and a "Groundskeeper Output" mod folder is created in your mods folder for you. With Vortex or a plain install, leave it empty and the plugin is written straight into the game's Data folder. Only this tool's own plugin names in it are ever replaced.
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="PASSES">
                        <StackPanel>
                            <CheckBox x:Name="SeamsCheck" Content="Seams: repair height, normal and colour seams (and lost water) between cells" IsChecked="True"/>
                            <CheckBox x:Name="TexturesCheck" Content="Texture layers: repair texture boundaries between cells" IsChecked="True"/>
                            <CheckBox x:Name="FloatingCheck" Content="Floating objects: re-ground floating and sunken references"/>
                            <CheckBox x:Name="NeighborsCheck" Content="Match neighbouring cells to the trusted terrain chain"/>
                            <CheckBox x:Name="NorthernCheck" Content="Trust Northern Roads terrain as a source"/>
                            <CheckBox x:Name="VanaheimrCheck" Content="Trust Northern Vanaheimr Roads terrain as a source (main plugin and patches)"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="PREFERRED ROAD MOD">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6">
                                Pick the road mod whose terrain should win wherever it conflicts with other mods. This is only for road mods that
                                EDIT THE LANDSCAPE (they reshape the terrain heights). Road mods that only change textures do not count here.
                                Its own patches rank above it. The list fills in when you scan.
                            </TextBlock>
                            <ComboBox x:Name="PreferredRoadCombo" Margin="0,3,4,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="TERRAIN CONFLICTS - WHO OVERWRITES TRUSTED TERRAIN">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6">
                                Scan lists every mod that overwrites terrain a trusted plugin (game, patches) authored. Mods are KEPT as they are
                                unless you tick them to be reverted. Nothing ticked = no terrain is changed.
                            </TextBlock>
                            <Button x:Name="ScanButton" Content="Scan for terrain conflicts" HorizontalAlignment="Left" Click="Scan_Click"/>
                            <TextBlock x:Name="ScanSummary" Style="{StaticResource Hint}" Margin="0,4,0,4" TextWrapping="Wrap"/>
                            <StackPanel x:Name="ConflictList"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="TERRAIN WINNERS - YOU DECIDE (FIRST = HIGHEST PRIORITY)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6">
                                Use "Make winner" on a mod in the list above to put it here. A mod is added in its load-order place (the one loaded last on
                                top), and you can then move it with the arrows. Where these mods conflict, the one highest in this list wins, and each beats every mod not listed. The usual safety checks still apply: cells with their own
                                water or with placed objects that would move are skipped and reported. Empty = load order decides.
                            </TextBlock>
                            <Button x:Name="SortWinnersButton" Content="Sort by load order" HorizontalAlignment="Left" Click="SortWinners_Click" ToolTip="Put the list back in load-order order (the mod loaded last on top)."/>
                            <StackPanel x:Name="WinnersList"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="WATER MODS TO PROTECT (FIRST = HIGHEST PRIORITY)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6">
                                Tick a water mod to restore its water wherever a later plugin overwrote it. When two ticked mods touch the same
                                cell the one higher in the list wins; use the arrows to reorder. Filled in by the scan. Nothing ticked = no water protection.
                            </TextBlock>
                            <StackPanel x:Name="WaterList"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="ROADS (OPTIONAL)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6">
                                Reconciles a road mod's terrain with the rest. It only runs when a road source plugin is named below. It needs the road
                                images from ACMOS Road Generator (Nexus mod 79205), which are NOT included: extract that mod and pick the folder that holds
                                "Roads" and "Paths Only" (each with a folder per worldspace, for example Roads\tamriel).
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Road source plugin:" ToolTip="The road mod's plugin, for example Northern Roads.esp. Leave empty to skip the road pass."/>
                                <TextBox Grid.Column="1" x:Name="RoadPluginBox" TextChanged="RoadMasks_Changed" ToolTip="The road mod's plugin, for example Northern Roads.esp. Leave empty to skip the road pass."/>
                                <TextBlock Grid.Row="1" Text="Road mask folder:" ToolTip="The ACMOS Road Generator road images (the folder that contains 'Roads' and 'Paths Only')."/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="RoadMasksBox" TextChanged="RoadMasks_Changed" ToolTip="The ACMOS Road Generator road images (the folder that contains 'Roads' and 'Paths Only')."/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseRoadMasks_Click"/>
                                <TextBlock Grid.Row="2" Text="Worldspace:" ToolTip="Which worldspace to process; Tamriel is the main map."/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="RoadWorldspaceBox" Text="Tamriel" TextChanged="RoadMasks_Changed"/>
                            </Grid>
                            <TextBlock x:Name="RoadMasksStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="LOG" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" Margin="0"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar x:Name="Bar" Height="6" IsIndeterminate="False" Visibility="Hidden" Margin="0,0,10,4"/>
                <TextBlock x:Name="StatusText" Text="Ready." Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="OpenMapCheck" Content="Open the problem map after Generate" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Scans the result for seams and floating objects that may still be wrong and shows them on a map."/>
                <Button x:Name="MapButton" Content="Problem map..." Click="Map_Click" Margin="0,3,8,3" ToolTip="Read-only scan of your current load order for what may still be broken, drawn on a map."/>
                <Button x:Name="DryRunButton" Content="Preview (no files written)" Click="Run_Click" Tag="dry" Margin="0,3,8,3"/>
                <Button x:Name="WriteButton" Content="Generate" Style="{StaticResource PrimaryButton}" Click="Run_Click" Tag="write" Margin="0,3,8,3"/>
                <Button x:Name="OpenButton" Content="Open output folder" Click="OpenOutput_Click" Margin="0,3,0,3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
