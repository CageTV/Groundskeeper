<Window x:Class="LandscapeHybrid.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Landscape Hybrid" Height="720" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3,4,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF3A2F05" BorderBrush="#FF8A6F00" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Foreground="#FFFFD966" TextWrapping="Wrap" Margin="0" FontSize="12">
                Not yet tested in-game. Runs the landscape tools (seams, texture layers, roads, floating objects) over your
                Mod Organizer 2 load order and merges them into one plugin. Works alongside Landscape Fixer by Cl3mus33:
                its LandscapeFixer.esp is never used as a source, so run the two in either order.
            </TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="440"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="12*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <GroupBox Header="MOD ORGANIZER 2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Instance folder:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="InstanceBox" TextChanged="InstanceBox_TextChanged"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseInstance_Click"/>
                            <TextBlock Grid.Row="1" Text="Profile:"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ProfileCombo" Margin="0,3,4,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="(auto-listed)" Style="{StaticResource Hint}"/>
                            <TextBlock Grid.Row="2" Text="Game folder:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="GameBox"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseGame_Click"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="OUTPUT">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output folder:"/>
                                <TextBox Grid.Column="1" x:Name="OutputBox"/>
                                <Button Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Plugin name:"/>
                                <TextBox Grid.Column="1" x:Name="PluginNameBox" Text="LandscapeTerrain.esp"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap">
                                Use a dedicated folder, e.g. a "Landscape Hybrid Output" mod folder. Only this tool's own plugin names in it are ever replaced.
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="PASSES">
                        <StackPanel>
                            <CheckBox x:Name="SeamsCheck" Content="Seams: repair height, normal and colour seams (and lost water) between cells" IsChecked="True"/>
                            <CheckBox x:Name="TexturesCheck" Content="Texture layers: repair texture boundaries between cells" IsChecked="True"/>
                            <CheckBox x:Name="FloatingCheck" Content="Floating objects: re-ground floating and sunken references (needs PyNifly + SciPy for mesh collision)"/>
                            <CheckBox x:Name="NeighborsCheck" Content="Match neighbouring cells to the trusted terrain chain"/>
                            <CheckBox x:Name="NorthernCheck" Content="Trust Northern Roads terrain as a source"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="ROADS (OPTIONAL)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Road source plugin:"/>
                            <TextBox Grid.Column="1" x:Name="RoadPluginBox"/>
                            <TextBlock Grid.Row="1" Text="Road mask folder:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="RoadMasksBox"/>
                            <TextBlock Grid.Row="2" Text="Worldspace:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="RoadWorldspaceBox" Text="Tamriel"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="LOG" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" Margin="0"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar x:Name="Bar" Height="6" IsIndeterminate="False" Visibility="Hidden" Margin="0,0,10,4"/>
                <TextBlock x:Name="StatusText" Text="Ready." Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DryRunButton" Content="Preview (no files written)" Click="Run_Click" Tag="dry" Margin="0,3,8,3"/>
                <Button x:Name="WriteButton" Content="Generate" Style="{StaticResource PrimaryButton}" Click="Run_Click" Tag="write" Margin="0,3,8,3"/>
                <Button x:Name="OpenButton" Content="Open output folder" Click="OpenOutput_Click" Margin="0,3,0,3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
