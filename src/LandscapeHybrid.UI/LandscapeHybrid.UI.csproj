<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>..\..\assets\Groundskeeper.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Groundskeeper</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- MO2's USVFS hooks reject the CET shadow stack: keep it off so the app can start from MO2's executables list. -->
    <CETCompat>false</CETCompat>
    <Version>0.1.0</Version>
    <Product>Groundskeeper</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- the window icon and the logo shown in the header -->
    <Resource Include="..\..\assets\Groundskeeper.ico" Link="Assets\Groundskeeper.ico" />
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LandscapeHybrid.Core\LandscapeHybrid.Core.csproj" />
  </ItemGroup>
</Project>
