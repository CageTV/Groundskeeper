<Window x:Class="LandscapeHybrid.UI.ReliefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Groundskeeper - 3D terrain" Icon="Assets/Groundskeeper.ico" Height="760" Width="1200" MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,3,0,3"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,3,6,3"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#FF0B0D11" ClipToBounds="True">
            <Viewport3D x:Name="View" ClipToBounds="True">
                <Viewport3D.Camera><PerspectiveCamera x:Name="Cam" FieldOfView="55" NearPlaneDistance="50" FarPlaneDistance="400000"/></Viewport3D.Camera>
                <ModelVisual3D x:Name="Scene"/>
            </Viewport3D>
            <!-- the Viewport3D only gets mouse events where something is drawn: this transparent layer catches them all -->
            <Border x:Name="Catcher" Background="Transparent"/>
            <Border x:Name="BusyOverlay" Background="#CC0E1014" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                    <TextBlock x:Name="BusyText" Text="Reading terrain..." FontSize="15" TextWrapping="Wrap" TextAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Hint" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,10" Foreground="{StaticResource Muted}"
                       Text="Drag to rotate, right-drag to pan, wheel to zoom."/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="12">
            <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Info" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,10"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <TextBlock Text="Height exaggeration" Margin="0,0,8,0"/>
                <Slider x:Name="ExagSlider" Grid.Column="1" Minimum="1" Maximum="8" Value="1" ValueChanged="Exag_Changed"/>
                <TextBlock x:Name="ExagText" Grid.Column="2" Text="1x" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Cells around" Margin="0,0,8,0"/>
                <ComboBox x:Name="RadiusCombo" Grid.Column="1" SelectionChanged="Radius_Changed">
                    <ComboBoxItem Content="1 (3 x 3)"/><ComboBoxItem Content="2 (5 x 5)" IsSelected="True"/><ComboBoxItem Content="3 (7 x 7)"/>
                </ComboBox>
            </Grid>
            <CheckBox x:Name="WaterCheck" Content="Water" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed"/>
            <CheckBox x:Name="MarksCheck" Content="Problem marks" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed"/>
            <CheckBox x:Name="WireCheck" Content="Cell borders" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed"/>
            <TextBlock Text="Move to the next cell" Margin="0,10,0,2"/>
            <Grid Width="200" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Button Grid.Column="1" Content="North" Click="North_Click" Margin="2"/>
                <Button Grid.Row="1" Grid.Column="0" Content="West" Click="West_Click" Margin="2"/>
                <Button Grid.Row="1" Grid.Column="1" Content="South" Click="South_Click" Margin="2"/>
                <Button Grid.Row="1" Grid.Column="2" Content="East" Click="East_Click" Margin="2"/>
            </Grid>
            <TextBlock Text="Legend" Margin="0,12,0,2" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FFFF5A4F" Text="Red wall: height step across a cell edge (the wall is the step)."/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF3DD6F5" Text="Cyan strip: possible water seam."/>
            <TextBlock TextWrapping="Wrap" Foreground="#FFC768D8" Text="Purple strip: texture seam."/>
            <TextBlock TextWrapping="Wrap" Foreground="#FFFFB32B" Text="Amber post: cell has floating objects left alone."/>
            <TextBlock TextWrapping="Wrap" Foreground="White" Text="White: the mark you picked on the map."/>
        </StackPanel>
    </Grid>
</Window>
