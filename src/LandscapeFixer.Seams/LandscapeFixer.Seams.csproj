<Project Sdk="Microsoft.NET.Sdk">

  <!-- Merged core of the CageTV landscape tools (Seam Fixer, Road Mask Merger, Texture Fixer,
       Floating Object Fixer, PatchForeman). Namespace stays SeamFinder.Core so the passes port 1:1. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Groundskeeper.Seams</AssemblyName>
    <RootNamespace>SeamFinder.Core</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- NIF/Havok reading for the floating-object pass (replaces Python + PyNifly). GPL-3.0, native x64 mixed-mode library. -->
    <PackageReference Include="niflysharp" Version="2.0.4" />
  </ItemGroup>

</Project>
